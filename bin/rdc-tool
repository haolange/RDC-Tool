#!/usr/bin/env sh
# rdc-tool launcher: run the CLI with this installation's bundled Python.
set -eu
tools_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
script="$tools_root/cli/run_cli.py"
host="$(uname -s)-$(uname -m)"
case "$host" in
  Linux-x86_64)
    python="$tools_root/binaries/linux/x64/python/bin/python3.14" ;;
  MINGW*-x86_64|MSYS*-x86_64|CYGWIN*-x86_64)
    python="$tools_root/binaries/windows/x64/python/python.exe" ;;
  *)
    echo "rdc-tool: this installation has no runtime for host $host" >&2
    exit 2 ;;
esac
if [ ! -f "$python" ]; then
  echo "Bundled Python is missing. Repair this RDC-Tool installation." >&2
  exit 2
fi
case "$host" in
  Linux-*) ;;
  *) python=$(cygpath -w "$python"); script=$(cygpath -w "$script") ;;
esac
unset PYTHONHOME PYTHONPATH
exec "$python" -s "$script" "$@"
